# Copy to .env and replace these example device paths with your own.
# Find serial ports: ls -l /dev/serial/by-id/
# Find camera: ls -l /dev/v4l/by-id/
SO101_LEADER_PORT=/dev/serial/by-id/REPLACE_WITH_LEADER
SO101_FOLLOWER_PORT=/dev/serial/by-id/REPLACE_WITH_FOLLOWER
SO101_CAMERA=/dev/v4l/by-id/REPLACE_WITH_CAMERA-video-index0
